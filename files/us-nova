// Nova custom single-group layout for Lemokey X2
// Behavior profile: nova-single-group-keypad-2026-07-26
// Decision record: docs/decisions/0003-single-group-numeric-keypad.md
// The layout, transport meanings, and fixed keypad behavior are deliberately
// self-contained so GNOME does not need a second group or a post-rules option.

default partial alphanumeric_keys modifier_keys keypad_keys
xkb_symbols "base" {
    include "us"

    name[Group1] = "Nova custom 4-level";

    // ---------------------------------------------------------------------
    // Number row (` 1 2 3 4 5 6 7 8 9 0 - =)
    // L1/L2: standard US. L3/L4: symbols from Nova's table.
    // Pass-through "⋄" → NoSymbol here.

    key <TLDE> { [ grave,      asciitilde,        U2393,        U23E6        ] }; // `, ~, ⎓, ⏦
    key <AE01> { [ 1,          exclam,            U203C,        U26A0        ] }; // 1, !, ‼, ⚠
    key <AE02> { [ 2,          at,                U20BF,        U2621        ] }; // 2, @, ₿, ☡
    key <AE03> { [ 3,          numbersign,        U03C0,        U03C4        ] }; // 3, #, π, τ
    key <AE04> { [ 4,          dollar,            U20B9,        U03C6        ] }; // 4, $, ₹, φ
    key <AE05> { [ 5,          percent,            U20AC,        U214C        ] }; // 5, %, €, ⅌
    key <AE06> { [ 6,          asciicircum,       U2211,        U03B8        ] }; // 6, ^, ∑, θ
    key <AE07> { [ 7,          ampersand,         U214B,        U2295        ] }; // 7, &, ⅋, ⊕
    key <AE08> { [ 8,          asterisk,           U2042,        U2297        ] }; // 8, *, ⁂, ⊗
    key <AE09> { [ 9,          parenleft,          U25B3,        U0394        ] }; // 9, (, △, Δ
    key <AE10> { [ 0,          parenright,         U25CB,        U2610        ] }; // 0, ), ○, ☐
    key <AE11> { [ minus,      underscore,        U2205,        U1F16D       ] }; // -, _, ∅, 🅭
    key <AE12> { [ equal,      plus,              U2248,        U2261        ] }; // =, +, ≈, ≡

    // ---------------------------------------------------------------------
    // Q row (Q W E R T Y U I O P [ ] \)

    key <AD01> { [ q,          Q,                 U2620,        U2623        ] }; // ☠, ☣
    key <AD02> { [ w,          W,                 U016D,        U016C        ] }; // ŭ, Ŭ
    key <AD03> { [ e,          E,                 U00EB,        U00CB        ] }; // ë, Ë
    key <AD04> { [ r,          R,                 U01BF,        U01F7        ] }; // ƿ, Ƿ
    key <AD05> { [ t,          T,                 U00FE,        U00DE        ] }; // þ, Þ
    key <AD06> { [ y,          Y,                 U2713,        U2611        ] }; // ✓, ☑
    key <AD07> { [ u,          U,                 U00FC,        U00DC        ] }; // ü, Ü
    key <AD08> { [ i,          I,                 U00EF,        U00CF        ] }; // ï, Ï
    key <AD09> { [ o,          O,                 U00F6,        U00D6        ] }; // ö, Ö
    key <AD10> { [ p,          P,                 U03A6,        U2117        ] }; // Φ, ℗
    key <AD11> { [ bracketleft,  braceleft,       U29D8,        U2235        ] }; // ⧘, ∵
    key <AD12> { [ bracketright, braceright,      U29D9,        U2234        ] }; // ⧙, ∴
    key <BKSL> { [ backslash,    bar,             U2763,        U2762        ] }; // ❣, ❢

    // ---------------------------------------------------------------------
    // A row (A S D F G H J K L ; ')

    key <AC01> { [ a,          A,                 U00E4,        U00C4        ] }; // ä, Ä
    key <AC02> { [ s,          S,                 U015D,        U015C        ] }; // ŝ, Ŝ
    key <AC03> { [ d,          D,                 U00F0,        U00D0        ] }; // ð, Ð
    key <AC04> { [ f,          F,                 U2109,        U2103        ] }; // ℉, ℃
    key <AC05> { [ g,          G,                 U011D,        U011C        ] }; // ĝ, Ĝ
    key <AC06> { [ h,          H,                 U0125,        U0124        ] }; // ĥ, Ĥ
    key <AC07> { [ j,          J,                 U0135,        U0134        ] }; // ĵ, Ĵ
    key <AC08> { [ k,          K,                 U021D,        U021C        ] }; // ȝ, Ȝ
    key <AC09> { [ l,          L,                 U03BB                      ] }; // λ
    key <AC10> { [ semicolon,  colon,             U2236,        U2237        ] }; // ∶, ∷
    key <AC11> { [ apostrophe, quotedbl,          U2032,        U2033        ] }; // ′, ″

    // ---------------------------------------------------------------------
    // Z row (Z X C V B N M , . /)

    key <AB01> { [ z,          Z,                 U03A9                      ] }; // Ω
    key <AB02> { [ x,          X,                 U0192,        U017F        ] }; // ƒ, ſ
    key <AB03> { [ c,          C,                 U0109,        U0108        ] }; // ĉ, Ĉ
    key <AB04> { [ v,          V,                 U269B,        U2622        ] }; // ⚛, ☢
    key <AB05> { [ b,          B,                 U03B2,        U03B1        ] }; // β, α
    key <AB06> { [ n,          N,                 U2717,        U2612        ] }; // ✗, ☒
    key <AB07> { [ m,          M,                 U211E,        U2695        ] }; // ℞, ⚕
    key <AB08> { [ comma,      less,              U2264,        U2272        ] }; // ≤, ≲
    key <AB09> { [ period,     greater,           U2265,        U2273        ] }; // ≥, ≳
    key <AB10> { [ slash,      question,          U2047,        U2E2E        ] }; // ⁇, ⸮

    // ---------------------------------------------------------------------
    // Arrow keys and space

    key <UP>   { [ Up,    Up,    U2191, U1F446 ] }; // ↑, 👆
    key <LEFT> { [ Left,  Left,  U2190, U1F448 ] }; // ←, 👈
    key <DOWN> { [ Down,  Down,  U2193, U1F447 ] }; // ↓, 👇
    key <RGHT> { [ Right, Right, U2192, U1F449 ] }; // →, 👉
    key <SPCE> { [ space, space, U202F, U00AD ] }; // NNBSP, SHY

    // ---------------------------------------------------------------------
    // Dedicated firmware transports

    virtual_modifiers Meta;

    replace key <I674> { [ Hyper_L ] };             // PB11 → Hyper
    replace key <I675> { [ Multi_key ] };           // PB12 → Compose
    replace key <I688> { [ ISO_Level3_Shift ] };    // PB25 → AltGr / Level3
    replace key <I689> { [ XF86Macro26 ] };         // PB26 → Any
    replace key <I691> { [ XF86Macro28 ] };         // PB28 → Whisper
    replace key <I692> { [ ISO_Level5_Shift ] };    // PB29 → Level5

    // KC_APP arrives as <COMP>; KC_MENU arrives as <PROP>.
    replace key <COMP> {
        [ Meta_R ],
        virtualModifiers = Meta
    };
    replace key <PROP> { [ Menu ] };

    // ---------------------------------------------------------------------
    // Always-numeric keypad

    replace key <NMLK> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ NoSymbol ] };

    replace key <KP7>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_7 ] };
    replace key <KP8>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_8 ] };
    replace key <KP9>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_9 ] };
    replace key <KP4>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_4 ] };
    replace key <KP5>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_5 ] };
    replace key <KP6>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_6 ] };
    replace key <KP1>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_1 ] };
    replace key <KP2>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_2 ] };
    replace key <KP3>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_3 ] };
    replace key <KP0>  { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_0 ] };
    replace key <KPDL> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_Decimal ] };
    replace key <KPPT> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_Decimal ] };
    replace key <KPEN> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_Enter ] };
    replace key <KPEQ> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_Equal ] };
    replace key <KPDV> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_Divide ] };
    replace key <KPMU> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_Multiply ] };
    replace key <KPSU> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_Subtract ] };
    replace key <KPAD> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ KP_Add ] };

    // Remove inherited Meta, Level5, and NumLock assignments, then attach
    // Nova's physical transports to their intended real modifier bits.
    modifier_map None { Meta_L, Meta_R };
    modifier_map None { <META> };
    modifier_map None { <LVL5> };
    modifier_map None { Num_Lock };
    modifier_map Mod2 { <I692> };
    modifier_map Mod3 { <COMP> };
    modifier_map Mod5 { <I688> };

    // Hyper intentionally remains a keysym-only userland command namespace.
};
